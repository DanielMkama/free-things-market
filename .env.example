# Copy to .env.local for local development.
# Get these from your Supabase project → Project Settings → API.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / public key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key — SERVER ONLY. Used by the admin client + scripts/*.
# Never prefix with NEXT_PUBLIC_ and never ship it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL, used in emails and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email. Without a key, emails are logged to the server console.
RESEND_API_KEY=
MAIL_FROM=The Free Things Market <hello@freethings.market>
